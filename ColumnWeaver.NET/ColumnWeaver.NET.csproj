<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <AssemblyName>ColumnWeaver.NET</AssemblyName>
    <RootNamespace>ColumnWeaver.NET</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>ColumnWeaver</Company>
    <Product>ColumnWeaver.NET</Product>
    <Description>Configurable object-to-record formatting for .NET Framework 4.8 and modern .NET. Reuse one schema-driven engine across customers with property, formula, conditional, custom-function, and fixed-text columns, separators, fixed-width rules, and JSON/XML configuration.</Description>
    <PackageTitle>ColumnWeaver.NET</PackageTitle>
    <Version>1.0.2-beta</Version>
    <PackageVersion>1.0.2-beta</PackageVersion>
    <Authors>Hitesh Bhanushali</Authors>
    <PackageProjectUrl>https://hiteshbhanushali-techmaster.github.io/ColumnWeaver.NET/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hiteshbhanushali-techmaster/ColumnWeaver.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>ColumnWeaver.NET;client-specific-formatting;customer-specific-formatting;configurable-data-export;object-to-string;object-to-record;schema-driven-formatting;structured-records;string-formatting;data-transformation;delimited-export;fixed-width;fixed-width-records;financial;trading;trading-data;formula-columns;conditional-columns;custom-functions;JSON-configuration;XML-configuration;batch-processing;net48;netstandard20</PackageTags>
    <PackageReleaseNotes>Clarifies when ColumnWeaver.NET fits schema-driven structured records compared with general template engines and CSV libraries. No runtime API changes.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>columnweaver-icon.png</PackageIcon>
    <IncludeSymbols>false</IncludeSymbols>
    <SymbolPackageFormat></SymbolPackageFormat>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddColumnWeaverAssembliesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColumnWeaver.NET.Core\ColumnWeaver.NET.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ColumnWeaver.NET.Application\ColumnWeaver.NET.Application.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ColumnWeaver.NET.Infrastructure\ColumnWeaver.NET.Infrastructure.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NCalc" Version="7.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\COMMERCIAL-LICENSING.md" Link="COMMERCIAL-LICENSING.md" Pack="true" PackagePath="\" />
    <None Include="..\docs\assets\columnweaver-icon.png" Link="columnweaver-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="AddColumnWeaverAssembliesToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\ColumnWeaver.NET.Core\bin\$(Configuration)\$(TargetFramework)\ColumnWeaver.NET.Core.dll">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\ColumnWeaver.NET.Application\bin\$(Configuration)\$(TargetFramework)\ColumnWeaver.NET.Application.dll">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\ColumnWeaver.NET.Infrastructure\bin\$(Configuration)\$(TargetFramework)\ColumnWeaver.NET.Infrastructure.dll">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\ColumnWeaver.NET.Core\bin\$(Configuration)\$(TargetFramework)\ColumnWeaver.NET.Core.xml">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\ColumnWeaver.NET.Application\bin\$(Configuration)\$(TargetFramework)\ColumnWeaver.NET.Application.xml">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\ColumnWeaver.NET.Infrastructure\bin\$(Configuration)\$(TargetFramework)\ColumnWeaver.NET.Infrastructure.xml">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="RemoveBundledProjectReferencesFromPackage" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
    </ItemGroup>
  </Target>

</Project>
