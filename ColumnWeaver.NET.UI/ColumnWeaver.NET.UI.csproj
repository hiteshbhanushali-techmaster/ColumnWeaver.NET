<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ColumnWeaver.NET.UI</AssemblyName>
    <RootNamespace>ColumnWeaver.NET.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <!-- Suppress legacy Windows Forms designer warnings for programmatic UI -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Company>ColumnWeaver.NET</Company>
    <Product>ColumnWeaver.NET Configuration Editor</Product>
    <Description>WinForms UI for configuring and testing the ColumnWeaver.NET pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for JObject parsing in the test-input panel -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ColumnWeaver.NET.Application">
      <HintPath>..\Final_Libs\ColumnWeaver.NET.Application.dll</HintPath>
    </Reference>
    <Reference Include="ColumnWeaver.NET.Core">
      <HintPath>..\Final_Libs\ColumnWeaver.NET.Core.dll</HintPath>
    </Reference>
    <Reference Include="ColumnWeaver.NET.Infrastructure">
      <HintPath>..\Final_Libs\ColumnWeaver.NET.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="NCalc">
      <HintPath>..\Final_Libs\NCalc.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\ColumnWeaver.NET.Infrastructure\bin\Release\net48\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
